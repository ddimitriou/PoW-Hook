#!/usr/bin/env python3
"""
PoW-Hook commit-msg: sign the session recorded by pre-commit and inject the
PoW-Checks trailer (v2 when a challenge receipt is present, v1 otherwise).

Configuration (POW JSON env var / .env): ssh_key, ssh_key_override.
"""
import json
import os
import subprocess
import sys

for _stream in (sys.stdout, sys.stderr):  # emoji-safe output on cp1252 consoles (Windows hooks)
    if hasattr(_stream, "reconfigure"):
        _stream.reconfigure(errors="replace")

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from pow_trailer import ZERO_SHA, TRAILER_KEY, build_sign_payload, encode_pow_trailer, load_pow_config  # noqa: E402

from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import padding
from cryptography.hazmat.primitives.asymmetric.rsa import RSAPrivateKey
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
from cryptography.hazmat.primitives.asymmetric.ed448 import Ed448PrivateKey
from cryptography.hazmat.primitives.asymmetric.ec import EllipticCurvePrivateKey, ECDSA

msg_file = sys.argv[1]


def load_env():
    try:
        repo_root = subprocess.check_output(["git", "rev-parse", "--show-toplevel"]).decode().strip()
        env_path = os.path.join(repo_root, ".env")
        if os.path.exists(env_path):
            with open(env_path) as f:
                for line in f:
                    if "=" in line and not line.strip().startswith("#"):
                        key, val = line.strip().split("=", 1)
                        val = val.strip().strip("'\"")
                        if key not in os.environ:
                            os.environ[key] = val
    except Exception:
        pass


def find_ssh_key(cfg):
    """Return the SSH private key path used for github.com connections."""
    env_key = cfg.get("ssh_key", "")
    if env_key and os.path.exists(env_key):
        return env_key

    override = cfg.get("ssh_key_override", "") or os.environ.get("POW_SSH_KEY_OVERRIDE", "")
    if override and os.path.exists(override):
        return override

    try:
        out = subprocess.check_output(["ssh", "-G", "github.com"], stderr=subprocess.DEVNULL).decode()
        for line in out.splitlines():
            if line.startswith("identityfile "):
                path = os.path.expanduser(line.split(None, 1)[1])
                if os.path.exists(path):
                    return path
    except Exception:
        pass

    for candidate in ["~/.ssh/id_rsa", "~/.ssh/id_ed25519", "~/.ssh/id_ecdsa"]:
        path = os.path.expanduser(candidate)
        if os.path.exists(path):
            return path
    return None


def load_private_key(key_path):
    with open(key_path, "rb") as f:
        key_data = f.read()
    if b"OPENSSH PRIVATE KEY" in key_data:
        return serialization.load_ssh_private_key(key_data, password=None)
    return serialization.load_pem_private_key(key_data, password=None)


def sign_with_key(private_key, payload_bytes):
    if isinstance(private_key, RSAPrivateKey):
        return private_key.sign(payload_bytes, padding.PKCS1v15(), hashes.SHA256())
    if isinstance(private_key, (Ed25519PrivateKey, Ed448PrivateKey)):
        return private_key.sign(payload_bytes)
    if isinstance(private_key, EllipticCurvePrivateKey):
        return private_key.sign(payload_bytes, ECDSA(hashes.SHA256()))
    raise ValueError(f"Unsupported key type: {type(private_key).__name__}")


def anchor_sha():
    """First parent of HEAD (see pow_trailer.py for why not HEAD itself)."""
    try:
        return subprocess.check_output(["git", "rev-parse", "--verify", "-q", "HEAD~1"],
                                       stderr=subprocess.DEVNULL).decode().strip() or ZERO_SHA
    except subprocess.CalledProcessError:
        return ZERO_SHA


def main():
    load_env()
    cfg = load_pow_config()
    git_dir = os.path.abspath(subprocess.check_output(["git", "rev-parse", "--git-dir"]).decode().strip())
    passed_flag = os.path.join(git_dir, "POW_PASSED")

    if not os.path.exists(passed_flag):
        print("⚠️ Warning: No Proof-of-Work checks executed. Push will be rejected by backend.")
        return 0

    with open(passed_flag) as f:
        session = json.load(f)
    os.remove(passed_flag)

    session_id = session["session_id"]
    status = session["status"]
    pow_checks_hash = session.get("pow_checks_hash", "")
    challenge_id = session.get("challenge_id")
    receipt = session.get("receipt")

    try:
        tree_hash = subprocess.check_output(["git", "write-tree"]).decode().strip()
        anchor = anchor_sha() if challenge_id else None
        payload = build_sign_payload(pow_checks_hash, tree_hash, session_id, status, challenge_id, receipt, anchor)

        key_path = find_ssh_key(cfg)
        if not key_path:
            print("❌ Error: No SSH private key found. Run setup_hooks.py again.")
            return 1
        if not cfg.get("ssh_key"):
            print(f"⚠️  ssh_key not set in POW — using auto-detected key: {key_path}")
            print("   Ensure this key is registered at github.com/settings/keys,")
            print("   or set ssh_key in the POW JSON to the correct private key path.")
        private_key = load_private_key(key_path)
        sig_bytes = sign_with_key(private_key, payload)

        trailer_value = encode_pow_trailer(sig_bytes, session_id, status, pow_checks_hash, challenge_id, receipt, anchor)

        # Strip comment lines (e.g., from MERGE_MSG) before injecting trailers.
        # Otherwise git interpret-trailers appends after the comments, git then
        # strips the comments and the blank-line separator is lost, so
        # %(trailers:...) can no longer find the trailer block.
        with open(msg_file, "rb") as src:
            cleaned = subprocess.check_output(["git", "stripspace", "--strip-comments"], stdin=src)
        with open(msg_file, "wb") as f:
            f.write(cleaned)

        subprocess.check_call([
            "git", "interpret-trailers", "--in-place",
            "--trailer", f"{TRAILER_KEY}: {trailer_value}",
            msg_file,
        ])
        print(f"🔏 PoW trailer v{2 if challenge_id else 1} injected (session {session_id[:8]}…).")
    except Exception as e:
        print(f"❌ Error: Failed to sign tree or inject trailer: {e}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
